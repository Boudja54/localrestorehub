---
import Layout from "../layouts/Layout.astro";
import cities from "../data/cities.json";

const PHONE_DISPLAY = "+1 (844) 833-10-48";
---

<Layout title="Local Water Damage & Mold Remediation Directory | 24/7 US Response">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary via-primary-light to-primary text-white">
    <div class="max-w-5xl mx-auto px-4 py-20 md:py-28 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
        Fast, Reliable Help for Home Emergencies in Your City
      </h1>
      <p class="text-lg md:text-xl text-gray-200 max-w-3xl mx-auto mb-10 leading-relaxed">
        When water damage or toxic mold strikes, every minute counts. We connect you with verified, 
        24/7 local restoration experts in your exact zip code.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:+18448331048"
          class="inline-block bg-accent hover:bg-accent-hover text-white font-bold text-lg px-10 py-4 rounded-lg shadow-lg transition transform hover:scale-105"
        >
          📞 Call {PHONE_DISPLAY}
        </a>
        <a
          href="#cities"
          class="inline-block bg-white/10 hover:bg-white/20 text-white font-bold text-lg px-10 py-4 rounded-lg shadow-lg transition border border-white/30"
        >
          Find Your City
        </a>
      </div>
      <p class="mt-4 text-sm text-gray-200">Available 24/7 — calls are routed to verified local restoration providers.</p>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="bg-gray-soft border-y border-gray-200">
    <div class="max-w-5xl mx-auto px-4 py-6 flex flex-wrap justify-center gap-8 text-sm font-semibold text-primary">
      <span class="flex items-center gap-2">🕐 <span>Available 24/7</span></span>
      <span class="flex items-center gap-2">📍 <span>Local Dispatch</span></span>
      <span class="flex items-center gap-2">⚡ <span>Rapid Response</span></span>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-primary mb-12">
        How It Works
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="text-center bg-bg-light rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold text-primary mb-3">Select Your Local Area</h3>
          <p class="text-gray-600 leading-relaxed">
            Choose your city from our directory of local emergency service areas.
          </p>
        </div>
        <!-- Step 2 -->
        <div class="text-center bg-bg-light rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold text-primary mb-3">Read Local Safety Guidelines</h3>
          <p class="text-gray-600 leading-relaxed">
            Review our localized emergency response guides specific to your area.
          </p>
        </div>
        <!-- Step 3 -->
        <div class="text-center bg-bg-light rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-14 h-14 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold text-primary mb-3">Call the 24/7 Dispatch Line</h3>
          <p class="text-gray-600 leading-relaxed">
            Contact our local emergency dispatch for immediate professional intervention.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Cities -->
  <section id="cities" class="bg-bg-light py-20">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-primary mb-12">
        Find Emergency Help in Your City
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {cities.map((c) => (
          <a
            href={`/cities/${c.slug}`}
            class="block bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-lg hover:border-accent/30 transition group"
          >
            <div class="text-3xl mb-3">
              {c.state === "FL" ? "🌴" : c.state === "TX" ? "⭐" : "🏭"}
            </div>
            <h3 class="text-xl font-bold text-primary group-hover:text-accent transition mb-2">
              {c.city}, {c.state}
            </h3>
            <p class="text-sm text-gray-500 mb-3">{c.zip}</p>
            <span class="inline-block bg-accent/10 text-accent text-xs font-semibold px-3 py-1 rounded-full">
              {c.emergency}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Strip -->
  <section class="bg-accent text-white py-14">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Emergency? Don't Wait.</h2>
      <p class="text-lg text-white/90 max-w-2xl mx-auto">
        Our local dispatch operators are standing by 24/7 to connect you with verified restoration professionals in your area.
      </p>
      <a
        href="tel:+18448331048"
        class="mt-8 inline-block bg-white text-accent hover:bg-gray-100 font-bold text-xl px-10 py-4 rounded-lg shadow-lg transition"
      >
        📞 Call {PHONE_DISPLAY} Now
      </a>
    </div>
  </section>
</Layout>
