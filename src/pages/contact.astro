---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - US Emergency Local Hub">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-primary mb-8">Contact Us</h1>
    <div class="bg-bg-light rounded-xl p-8 border border-gray-200">
      <p class="text-gray-700 mb-6">
        For general inquiries, partnership opportunities, or questions about our directory, 
        please reach out via email.
      </p>
      <p class="text-lg">
        📧 <strong>Email:</strong> 
        <a href="mailto:contact.localrestore@gmail.com" class="text-primary-light hover:text-accent transition">
          contact.localrestore@gmail.com
        </a>
      </p>
      <p class="text-sm text-gray-500 mt-6">
        For <strong>emergency assistance</strong>, please visit your local city page for the direct dispatch number.
      </p>
    </div>
  </div>
</Layout>
