---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - Local Restore Hub">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-primary mb-8">Contact Us</h1>
    <div class="bg-bg-light rounded-xl p-8 border border-gray-200 space-y-6">
      <p class="text-gray-700">
        For general inquiries, partnership opportunities, or questions about our directory,
        please reach out via email.
      </p>
      <div>
        <p class="text-lg">
          📧 <strong>Email:</strong>
          <a href="mailto:contact.localrestore@gmail.com" class="text-primary-light hover:text-accent transition">
            contact.localrestore@gmail.com
          </a>
        </p>
        <p class="text-lg mt-3">
          📞 <strong>24/7 Emergency Line:</strong>
          <a href="tel:+18448331048" class="text-primary-light hover:text-accent transition font-semibold">
            +1 (844) 833-10-48
          </a>
        </p>
      </div>
      <p class="text-sm text-gray-500">
        For <strong>emergency assistance</strong>, call the dispatch line above or visit your local city page for localized guidance.
      </p>
    </div>
  </div>
</Layout>
