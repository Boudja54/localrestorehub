---
import Layout from "../layouts/Layout.astro";

const PHONE_DISPLAY = "+1 (844) 833-10-48";
const PHONE_TEL = "tel:+184****1048";
const HOURS = "Daily 10:00 AM - 2:00 AM";

const CITIES = [
  { slug: "water-damage-repair-el-segundo-ca", city: "El Segundo" },
  { slug: "water-damage-repair-vernon-ca", city: "Vernon" },
  { slug: "water-damage-repair-oxnard-ca", city: "Oxnard" },
  { slug: "water-damage-repair-moorpark-ca", city: "Moorpark" },
  { slug: "water-damage-repair-downey-ca", city: "Downey" },
  { slug: "water-damage-repair-santa-paula-ca", city: "Santa Paula" },
  { slug: "water-damage-repair-san-marino-ca", city: "San Marino" },
  { slug: "water-damage-repair-camarillo-ca", city: "Camarillo" },
];
---

<Layout
  title="Page Not Found | Local Restore Hub"
  description="The page you are looking for could not be found. Find water damage restoration help in your California city or call our dispatch line."
>
  <section class="bg-gradient-to-br from-primary via-primary-light to-primary text-white">
    <div class="max-w-4xl mx-auto px-4 py-20 md:py-28 text-center">
      <p class="text-6xl md:text-7xl font-extrabold mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">
        This page could not be found
      </h1>
      <p class="text-lg text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
        The address you followed may be outdated or mistyped. Our local dispatch line is still answered
        {HOURS}, so you can reach a verified water damage provider in your area right now.
      </p>
      <a href={PHONE_TEL}
         class="inline-flex items-center gap-3 bg-accent hover:bg-accent-hover text-white font-bold text-lg px-8 py-4 rounded-lg shadow-lg transition transform hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call {PHONE_DISPLAY}
      </a>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-primary mb-6">Popular Service Areas</h2>
      <p class="text-gray-700 leading-relaxed mb-8">
        Choose your city to reach local water damage restoration help, or return to the
        <a href="/" class="text-accent font-semibold underline">home page</a> to browse every California service area we cover.
      </p>
      <ul class="grid md:grid-cols-2 gap-3 mb-10">
        {CITIES.map((c) => (
          <li>
            <a href={`/${c.slug}/`} class="block bg-bg-light hover:bg-gray-soft border border-gray-200 rounded-lg px-4 py-3 text-primary font-semibold transition">
              💧 Water Damage Help in {c.city}, CA
            </a>
          </li>
        ))}
      </ul>

      <div class="bg-bg-light border border-gray-200 rounded-xl p-8 text-center">
        <p class="text-xl font-bold text-primary mb-4">Need immediate help?</p>
        <a href={PHONE_TEL}
           class="inline-flex items-center gap-3 bg-accent hover:bg-accent-hover text-white font-bold text-lg px-8 py-4 rounded-lg shadow transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call {PHONE_DISPLAY}
        </a>
        <p class="text-xs text-gray-500 mt-4">Our {HOURS} local dispatch is standing by to connect you with verified water damage professionals. By calling this number, you consent to being connected with a third-party service provider and to the recording of your call for quality assurance and compliance purposes. Read our <a href="/privacy-policy" class="underline">Privacy Policy</a> for full TCPA &amp; CCPA disclosures.</p>
      </div>
    </div>
  </section>
</Layout>
