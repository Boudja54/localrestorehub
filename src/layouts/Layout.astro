---
export interface Props {
  title: string;
  description?: string;
}

const { title, frontmatter, description: desc } = Astro.props;
const pageTitle = title || frontmatter?.title || "Local Restore Hub";
const pageDesc = desc || frontmatter?.description || "Local Restore Hub — Connecting you with verified local restoration experts daily";

// Canonical URL: always absolute, always www.localrestorehub.com + page slug
const canonicalURL = new URL(Astro.url.pathname, "https://www.localrestorehub.com").href;

const PHONE_DISPLAY = "+1 (844) 833-10-48";
const PHONE_TEL = "tel:+18448331048";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>@import "../styles/global.css";</style>
  </head>
  <body class="bg-bg-light text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    <!-- Header -->
    <header class="bg-primary text-white shadow-md sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <a href="/" class="text-lg md:text-xl font-bold tracking-tight hover:text-gray-200 transition whitespace-nowrap">
          🏠 Local Restore Hub
        </a>
        <div class="hidden md:flex gap-6 text-sm font-medium">
          <a href="/" class="hover:text-gray-300 transition">Home</a>
          <a href="/#how-it-works" class="hover:text-gray-300 transition">How It Works</a>
          <a href="/about" class="hover:text-gray-300 transition">About</a>
          <a href="/contact" class="hover:text-gray-300 transition">Contact</a>
        </div>
        <a
          href={PHONE_TEL}
          class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-bold text-sm md:text-base px-3 md:px-5 py-2 rounded-lg shadow transition whitespace-nowrap"
        >
          <span aria-hidden="true">📞</span>
          <span class="hidden sm:inline">{PHONE_DISPLAY}</span>
          <span class="sm:hidden">Call Now</span>
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1 px-4 md:px-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-primary text-gray-300 text-sm">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-4">
          <p>&copy; {new Date().getFullYear()} Local Restore Hub. All rights reserved.</p>
          <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
            <a href={PHONE_TEL} class="text-white font-semibold hover:text-gray-200 transition">
              📞 {PHONE_DISPLAY} — Emergency Line (Daily 10:00 AM - 2:00 AM)
            </a>
            <span class="hidden sm:inline text-gray-500">|</span>
            <div class="flex gap-4">
              <a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a>
              <a href="/terms-of-service" class="hover:text-white transition">Terms of Service</a>
              <a href="/contact" class="hover:text-white transition">Contact</a>
            </div>
          </div>
        </div>
        <!-- TCPA Compliance Notice -->
        <div class="border-t border-primary-light/30 pt-4 mt-2 text-xs text-gray-400 leading-relaxed text-center md:text-left">
          <p><strong>TCPA Consent Notice:</strong> By calling any telephone number displayed on this website, you expressly consent to being connected with third-party service providers and to the recording and/or monitoring of your call for quality assurance, training, and compliance purposes. You also consent to receive follow-up communications regarding your service inquiry. Consent is not a condition of purchase. <a href="/privacy-policy" class="text-gray-300 hover:text-white underline">Learn more</a>.</p>
          <p class="mt-2"><a href="/privacy-policy#ccpa-rights" class="text-gray-300 hover:text-white underline">Do Not Sell or Share My Personal Information (CCPA)</a></p>
        </div>
        <!-- Legal Disclaimer (Marketcall offer #12330 — exact required text) -->
        <div class="border-t border-primary-light/30 pt-4 mt-4 text-xs text-gray-400 leading-relaxed text-center md:text-left">
          <p>Disclaimer: Local Restore Hub is a free service to assist homeowners in connecting with local service providers. All contractors/providers are independent and Local Restore Hub does not warrant or guarantee any work performed. It is the responsibility of the homeowner to verify that the hired contractor furnishes the necessary license and insurance required for the work being performed. All persons depicted in a photo or video are actors or models and not contractors listed on Local Restore Hub.</p>
          <p class="mt-2">Same-day and 24/7 emergency services are subject to provider participation, location, technician availability, and demand. Availability is not guaranteed and may vary by market and appointment capacity.</p>
          <p class="mt-2"><strong>Affiliate Disclosure:</strong> Local Restore Hub may receive compensation from service providers for calls placed through this website. This does not affect the order in which providers are presented or the price you pay. Calls may be routed to an independent call center for matching.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
